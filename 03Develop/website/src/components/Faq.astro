---
import { faq } from '../content/site';
---

<section class="section section--alt" id="faq" aria-labelledby="faq-title">
  <div class="container faq">
    <div class="section-head">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title">Questions, answered</h2>
      <p>Starting something new can bring up questions. Here are a few things you might want to know before we work together.</p>
    </div>

    <div>
      <!-- Native <details> accordions: keyboard and screen-reader friendly without extra scripts -->
      <div class="faq__list">
        {faq.map((item) => (
          <details class="faq__item">
            <summary>
              <span class="faq__question">{item.question}</span>
              <span class="faq__icon" aria-hidden="true"></span>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>

      <p class="faq__more">
        Still have a question? I’d love to hear from you.
        <a href="#enquire" data-open-enquiry>Get in touch</a>
      </p>
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: 0.5rem;
  }
  .faq .section-head {
    margin-bottom: 1.5rem;
  }
  .faq__list {
    border-top: 1px solid var(--line);
  }
  .faq__item {
    border-bottom: 1px solid var(--line);
  }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 3.5rem;
    padding-block: 1.15rem;
    list-style: none;
    cursor: pointer;
    font-weight: 600;
    line-height: 1.45;
    color: var(--brown);
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary:hover {
    color: var(--plum);
  }

  /* Plus that turns into a minus when open */
  .faq__icon {
    position: relative;
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    margin-top: -0.75px;
    background: var(--plum);
    transition: transform 0.2s ease;
  }
  .faq__icon::after {
    transform: rotate(90deg);
  }
  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  .faq__item p {
    max-width: 42rem;
    margin: 0 0 1.5rem;
    line-height: 1.75;
  }

  .faq__more {
    margin: 2rem 0 0;
  }
  .faq__more a {
    margin-left: 0.25rem;
    font-weight: 600;
    color: var(--plum);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }
  .faq__more a:hover {
    text-decoration-thickness: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__icon::before,
    .faq__icon::after {
      transition: none;
    }
  }
  @media (min-width: 60rem) {
    .faq {
      grid-template-columns: 1fr 1.8fr;
      gap: 4rem;
    }
    /* Keep answers clear of the plus/minus column */
    .faq__item p {
      padding-right: 2.4rem;
    }
  }
</style>
