---
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/montserrat';
import '@fontsource/allura';
import '../styles/global.css';
import { seo } from '../content/site';
import { url } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = seo.title, description = seo.description, noindex = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// The homepage uses the dedicated sharing copy; other pages share their own title and description
const isHome = !Astro.props.title;
const ogTitle = isHome ? seo.ogTitle : title;
const ogDescription = isHome ? seo.ogDescription : description;
// Social sites need a full address for the image
const ogImage = Astro.site ? new URL(url(seo.ogImage), Astro.site).href : url(seo.ogImage);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F7F3EE" />
    <link rel="icon" href={url('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Strong with Mila" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:locale" content="en_GB" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={seo.ogImageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
