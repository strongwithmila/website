# Copy to `.env` and fill in. Never commit real values.

# Public domain once chosen, e.g. https://strongwithmila.de — enables canonical URL and og:url.
SITE_URL=

# Enquiry emails (sent by src/pages/api/enquiry.ts through Brevo). Set these in Vercel, not here,
# unless you want to test sending locally. Never commit real values.
BREVO_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# Optional: send the form somewhere other than /api/enquiry. Leave unset to use the built-in
# function; set to an empty value to fall back to opening a pre-filled email instead.
# PUBLIC_FORM_ENDPOINT=
